# ============================
# Hilbert 环境变量配置
# ============================
# 使用方式：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填入实际配置值
#   3. 也可直接设置系统环境变量（优先级高于 .env 文件）

# ----------------------------
# 基础配置
# ----------------------------

# 服务监听端口
PORT=3000

# 外部页面内容使用独立端口，防止目标页面脚本与 Hilbert UI 同源
EXTERNAL_PROXY_PORT=3001
# 浏览器访问代理内容的公开端口；经过端口映射或反向代理时单独配置
EXTERNAL_PROXY_PUBLIC_PORT=3001
# 可选：代理内容的完整公开 origin，设置后优先于 PUBLIC_PORT
# EXTERNAL_PROXY_PUBLIC_ORIGIN=https://hilbert.example.com:3443

# 超级管理员邮箱（拥有所有权限，可访问 RBAC 权限配置页面，多人用逗号分隔）
ADMIN_EMAIL=admin@example.com,boss@example.com

# ----------------------------
# Google OAuth2 配置
# ----------------------------
# 在 Google Cloud Console (https://console.cloud.google.com/) 创建 OAuth2 凭据
# 授权回调地址需与 GOOGLE_REDIRECT_URI 一致

# OAuth2 客户端 ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OAuth2 客户端密钥
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth2 回调地址（必须与 Google Cloud Console 中配置的一致）
GOOGLE_REDIRECT_URI=http://localhost:3000/callback?type=google

# OAuth2 权限范围（一般无需修改）
GOOGLE_OAUTH2_SCOPE=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# OAuth2 访问类型（一般无需修改）
GOOGLE_OAUTH2_ACCESS_TYPE=offline

# 是否包含授权的作用域（true/false）
GOOGLE_OAUTH2_INCLUDE_GRANTED_SCOPES=true

# OAuth2 响应类型（一般无需修改）
GOOGLE_OAUTH2_RESPONSE_TYPE=code

# Google 授权端点 URL（一般无需修改）
GOOGLE_OAUTH2_URL=https://accounts.google.com/o/oauth2/v2/auth

# Google Token 端点 URL（一般无需修改）
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# ----------------------------
# JWT 会话配置
# ----------------------------

# JWT 签名密钥（请生成随机字符串，如: openssl rand -base64 32）
JWT_SECRET=change-me-to-a-random-string

# 会话过期时间（小时），默认 720 小时 = 30 天
JWT_EXPIRE_HOURS=720

# ----------------------------
# 网络代理（可选）
# ----------------------------
# 国内服务器访问 Google API 需要配置代理
# 留空或不设置则不使用代理
GOOGLE_API_PROXY=http://127.0.0.1:10808

# 外部链接页面统一出站代理（HTTP/HTTPS 页面、自动认证和 WebSocket）
# 留空或不设置则由 Hilbert 直接连接目标页面
PAGE_PROXY=http://127.0.0.1:10808

# ----------------------------
# 登录限制（可选）
# ----------------------------
# 允许登录的邮箱域名（如 abel.com），为空则不限制域名
GOOGLE_ALLOWED_DOMAIN=example.com

# 允许登录的具体邮箱列表（逗号分隔），优先级高于域名限制
# 如：user1@example.com,user2@example.com
GOOGLE_ALLOWED_EMAILS=admin@example.com
